<!doctype html><html lang="sr"><head><meta charset="utf-8"><title>SEF ulazne fakture</title><style>body{font:14px system-ui;background:#f4f6fa;margin:0;color:#172033}main{max-width:1200px;margin:auto;padding:25px}section{background:white;padding:18px;margin:16px 0;border-radius:10px}form{display:flex;gap:10px;flex-wrap:wrap}input,select,button,a{padding:9px;border:1px solid #ccd3df;border-radius:6px}button,a{background:#185abd;color:white;text-decoration:none}table{width:100%;border-collapse:collapse;margin-top:14px}th,td{padding:9px;border-bottom:1px solid #eee;text-align:left}.num{text-align:right}.ok{background:#e7f6ec;padding:10px}.err{background:#fdecec;padding:10px}.wrap{overflow:auto}.progress-panel{display:none;margin-top:14px;padding:12px;background:#f8fafc;border:1px solid #dbe3ef;border-radius:8px}.progress-track{height:22px;background:#e5e7eb;border-radius:99px;overflow:hidden}.progress-fill{height:100%;width:0;background:#185abd;color:white;text-align:center;line-height:22px;font-weight:700;transition:width .3s}.progress-message{margin:8px 0 0}tbody tr{transition:background-color .15s ease}.status-new{background:#eef4ff}.status-seen{background:#f5f7fa}.status-renotified{background:#fff7db}.status-approved{background:#e6f6ea}.status-rejected{background:#ffd6d6;border-left:6px solid #c62828;font-weight:600}.status-storno{background:#f1d4ff;border-left:6px solid #7b1fa2;font-weight:700}.status-other{background:#fff}.status-rejected:hover{background:#ffc4c4}.status-storno:hover{background:#e8bdfc}</style></head><body><main><div style="display:flex;justify-content:space-between;align-items:center"><h1>SEF ulazne fakture</h1><a href="/settings">Podešavanja API ključa</a></div>{% for c,m in get_flashed_messages(with_categories=true) %}<p class="{{c}}">{{m}}</p>{% endfor %}<section><h2>Sinhronizacija</h2><form id="sync-form"><input type="text" name="date_from" placeholder="Datum od: DD/MM/YYYY" pattern="\d{2}/\d{2}/\d{4}" inputmode="numeric" required><input type="text" name="date_to" placeholder="Datum do: DD/MM/YYYY" pattern="\d{2}/\d{2}/\d{4}" inputmode="numeric" required><select name="status"><option value="">Svi statusi</option>{% for s in ['New','Seen','ReNotified','Approved','Rejected','Storno'] %}<option>{{s}}</option>{% endfor %}</select><button id="sync-button">Preuzmi sa SEF-a</button></form><div id="progress-panel" class="progress-panel"><div class="progress-track"><div id="progress-fill" class="progress-fill">0%</div></div><p id="progress-message" class="progress-message"></p></div></section><section><form><input name="q" value="{{q}}" placeholder="Broj, dobavljač ili PIB"><select name="status"><option value="">Svi statusi</option>{% for s in ['New','Seen','ReNotified','Approved','Rejected','Storno'] %}<option {% if status==s %}selected{% endif %}>{{s}}</option>{% endfor %}</select><button>Filtriraj</button><a href="/export.csv">CSV za Excel</a></form><div class="wrap"><table><tr><th>Broj</th><th>Dobavljač</th><th>PIB</th><th>Status</th><th>Osnovica</th><th>PDV</th><th>Datum fakture</th><th>Promet</th><th>Poslednja promena</th></tr>{% for r in rows %}<tr class="{{r.status|status_class}}"><td>{{r.document_number or r.invoice_id}}</td><td>{{r.supplier_name or ''}}</td><td>{{r.supplier_pib or ''}}</td><td>{{r.status or ''}}</td><td class="num">{{r.base_amount|number_sr}}</td><td class="num">{{r.vat_amount|number_sr}}</td><td>{{r.issue_date|date_sr}}</td><td>{{r.delivery_date|date_sr}}</td><td>{{r.status_changed_at|date_sr}}</td></tr>{% else %}<tr><td colspan="9">Nema podataka.</td></tr>{% endfor %}</table></div></section></main><script>const f=document.getElementById('sync-form'),b=document.getElementById('sync-button'),p=document.getElementById('progress-panel'),bar=document.getElementById('progress-fill'),msg=document.getElementById('progress-message');function show(x){bar.style.width=x.percent+'%';bar.textContent=x.percent+'%';msg.textContent=x.message}async function poll(id){let r=await fetch('/sync/progress/'+id),x=await r.json();show(x);if(x.state==='done'){setTimeout(()=>location.reload(),800)}else if(x.state==='error'){b.disabled=false;bar.style.background='#c62828'}else setTimeout(()=>poll(id),500)}f.onsubmit=async e=>{e.preventDefault();b.disabled=true;p.style.display='block';show({percent:0,message:'Pokretanje...'});let r=await fetch('/sync/start',{method:'POST',body:new FormData(f)}),x=await r.json();if(!r.ok){b.disabled=false;msg.textContent=x.error;return}poll(x.job_id)}</script></body></html>
